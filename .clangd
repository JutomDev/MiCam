    - -isystem
    - C:/Users/Julek/.platformio/packages/toolchain-xtensa-esp32s3/lib/gcc/xtensa-esp32s3-elf/8.4.0/include
    - -isystem
    - C:/Users/Julek/.platformio/packages/toolchain-xtensa-esp32s3/lib/gcc/xtensa-esp32s3-elf/8.4.0/include-fixed
    - -isystem
    - C:/Users/Julek/.platformio/packages/toolchain-xtensa-esp32s3/xtensa-esp32s3-elf/include
